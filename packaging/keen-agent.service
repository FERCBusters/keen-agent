[Unit]
Description=KEEN evidence collection agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=keen-agent
Group=keen-agent
# Optional groups are configured by the operator, according to local log policy.
ExecStart=/usr/local/bin/keen-agent -config /etc/keen-agent/config.yaml
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
StateDirectory=keen-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/keen-agent
MemoryMax=256M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
