ARG RELEASE=44
FROM fedora:${RELEASE} AS build
RUN dnf install -y ca-certificates curl-minimal tar gzip gcc rpm-build shadow-utils systemd-rpm-macros && dnf clean all
WORKDIR /src
COPY . .
RUN sh packaging/install-go.sh
ENV PATH="/usr/local/go/bin:${PATH}" GOTOOLCHAIN=local
RUN go test ./... && go vet ./... && CGO_ENABLED=0 go build -buildvcs=false -trimpath -ldflags='-s -w' -o dist/keen-agent ./cmd/keen-agent
RUN mkdir -p /root/rpmbuild/SOURCES /out && cp -a . /root/rpmbuild/SOURCES/keen-agent && . /etc/os-release && rpmbuild --define "dist .fc${VERSION_ID}" -bb packaging/keen-agent.spec && find /root/rpmbuild/RPMS -name '*.rpm' -exec cp '{}' /out/ ';'
FROM scratch AS packages
COPY --from=build /out/ /
